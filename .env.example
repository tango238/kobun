# --- LLM バックエンドの選択 ---
# pi:        Pi Durable を使う。ANTHROPIC_API_KEY が必須
# claude-cli: `claude -p` を使う。CLAUDE_CODE_OAUTH_TOKEN か ANTHROPIC_API_KEY が必須
LLM_BACKEND=claude-cli

# claude-cli 用: Claude Max の OAuth トークン (claude setup-token で発行した1年トークン)
# Max プランの枠で使いたい場合は ANTHROPIC_API_KEY を空にすること
CLAUDE_CODE_OAUTH_TOKEN=
# claude-cli のモデル指定 (任意。例: claude-sonnet-4-5)
CLAUDE_MODEL=

# pi 用 (LLM_BACKEND=pi のとき必須)。claude-cli でも API キー認証に使える
ANTHROPIC_API_KEY=
# pi のモデル (任意)
PI_MODEL_ID=claude-sonnet-4-5

# Outer Loop の改善 PR 作成に必要
# (sandbox の git push / PR 作成の通信時に、egress が実トークンへ差し替える)
GITHUB_TOKEN=
