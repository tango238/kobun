# LLM バックエンド: pi (Pi Durable) / claude-cli (claude -p)
LLM_BACKEND=claude-cli
# claude-cli の場合: CLAUDE_CODE_OAUTH_TOKEN (Claude Max) か ANTHROPIC_API_KEY のどちらかが必要
# CLAUDE_CODE_OAUTH_TOKEN は Mac 上で `claude setup-token` を実行して発行する (有効期限1年)
CLAUDE_CODE_OAUTH_TOKEN=
# pi の場合: ANTHROPIC_API_KEY が必須 (claude-cli と共用可)
ANTHROPIC_API_KEY=
# 任意: モデル指定 (空なら既定)
CLAUDE_MODEL=
PI_MODEL_ID=claude-sonnet-4-5
# エージェント組織のロール別モデル (Opus: チーフ/PjM/BA/エンジニアリード/デザイナー, Sonnet: 実装/UXアナリスト/インフラ)
MODEL_OPUS=claude-opus-5-5
MODEL_SONNET=claude-sonnet-5-5
# sandbox から GitHub を触る場合のみ (egress が差し替える本物のトークン)
GITHUB_TOKEN=
# sandbox から GitHub への書き込み (push / PR) を許す org またはユーザー名。空なら読み取りだけ許可する
EGRESS_GITHUB_ORG=
# 任意: クレデンシャルブローカーの暗号鍵の元になる文字列 (空なら broker-data ボリュームに自動生成)
BROKER_KEY=
# 任意: ブローカーをホストに公開するポート (既定 3100、127.0.0.1 のみ)
BROKER_PORT=3100
# 任意: Postgres をホストに公開するポート (既定 5432。ホストで使用中なら変える)
POSTGRES_PORT=5432
# 任意: エージェントに読ませるリポジトリの親ディレクトリ (ホストの絶対パス)。
# サンドボックスに読み取り専用でマウントされ、この下にあるリポジトリをエージェントが読めるようになる。
# .env や秘密鍵などは読み取りを拒否するが、それ以外のファイルは LLM に送られうる。空なら読ませない。
REPOS_DIR=
